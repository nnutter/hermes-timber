{
  "name": "hermes-timber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Hermes Desktop panel for Timber worktrees",
  "scripts": {
    "build": "esbuild ui/plugin.tsx --bundle --format=esm --target=es2022 --external:@hermes/plugin-sdk --external:react --external:react/jsx-runtime --outfile=desktop/plugin.js",
    "check": "tsc --noEmit && prettier --check ui tests/ui package.json tsconfig.json vitest.config.ts",
    "fix": "prettier --write ui tests/ui package.json tsconfig.json vitest.config.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@nanostores/react": "^2.0.1",
    "@tanstack/react-query": "^5.105.0",
    "nanostores": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
